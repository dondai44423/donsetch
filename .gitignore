# DonSeTch private working docs + build artifacts
status.md
project.md
design.md

# Private design blueprints — never public
design/

# V5 working docs — private (plan + discussion, decision log)
v5/

# Rust
/target
# Machine-specific cargo config (libclang/bindgen env — differs per OS)
.cargo/

# Editor / OS cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Benchmarks (results + corpus are local, not committed)
bench/results.json
bench/results/
bench/battle-corpus/
bench/improve/out/

# Vendored PDFium static libraries (build.rs auto-downloads)
# Root-anchored: the engine's own vendor/ tree (doncore/vendor) is committed.
/vendor/

# PDF corpus binaries (download via scripts/download-corpus.sh)
tests/pdf-corpus/*.pdf
!tests/pdf-corpus/corpus.md

# ONNX models (downloaded on first use, not bundled)
*.onnx

# Cache directories (local state)
.cache/
npm/binaries/
npm/LICENSE
*.tgz
bench/regression-results.json
/libonnxruntime.so

# The engine crate carries its own workspace + target until the swap links it
# into the app graph (its vendored BoringSSL cannot share the app's).
/doncore/target/
