# Docker ignore patterns for DonSeTch

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github

# Rust
target/
**/target/

# Fuzzing (development-only)
fuzz/

# Benchmarks (development-only)
bench/

# Scripts (development-only)
scripts/

# Assets (not needed for runtime)
assets/

# npm package (installed separately)
npm/

# Documentation (not needed for runtime)
docs/
*.md
!README.md

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker files (don't copy into image)
docker-compose*.yml
.dockerignore
Dockerfile*

# CloakBrowser is a user-managed runtime dependency. Never send downloaded
# archives or binaries to Docker build context; the image only contains
# DonSeTch itself and an optional system Chromium installation.
cloakbrowser/
**/cloakbrowser-*.tar.gz
**/cloakbrowser-*.zip
**/Chromium.app/
**/chromium-*/chrome
**/chromium-*/chrome.exe

# Development files
*.log
.env.*
!.env.example
